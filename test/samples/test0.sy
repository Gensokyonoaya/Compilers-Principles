int main() {
    float x = 3.14;
    const int y = 42;
    if (x == y) {
        x = 0;
    } else if (x != y) {
        if (x <= y) {
            x = y;
        } else {
            if (x == -1)
                if (y == 0)
                    x = 0;
                else
                    x = 1;
        }
    } else {
        x = 1;
    }
    if (x >= 0) return x;
}